{
  "name": "sch-campus-nav",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./src/lib/_register.mjs --test src/lib/*.test.ts",
    "data:buildings": "python3 tools/extract_buildings.py",
    "data:paths": "python3 tools/extract_paths.py",
    "graph": "python3 tools/extract_paths.py && node tools/route_rules.ts",
    "check:routes": "node tools/route_rules.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "maplibre-gl": "^6.18.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
